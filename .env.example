# Copy this file to .env and fill in your own values, then restart `npm run dev`.
# These are PUBLIC identifiers only (Key ID / App ID) — never put a secret key here.
# A secret key must live on a backend server, used to create orders server-side;
# it must never ship in frontend code or a Vite env var (those are bundled into
# the browser JS and are visible to anyone).

VITE_RAZORPAY_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_CASHFREE_APP_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
